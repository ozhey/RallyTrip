{
  "name": "rallytrip",
  "version": "1.0.0",
  "homepage": "https://www.rallytrip.com",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:emulator": "NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true next dev",
    "build": "next build",
    "build:static": "STATIC_EXPORT=true next build",
    "start": "next start",
    "serve:static": "node scripts/serve-static.mjs out 3201",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build-rules.mjs --emulator && firebase emulators:exec --project demo-rallytrip \"playwright test\"",
    "test:e2e:static": "E2E_STATIC=true npm run test:e2e",
    "emulators": "node scripts/build-rules.mjs --emulator && firebase emulators:start --project demo-rallytrip",
    "seed": "node scripts/seed-emulator.mjs",
    "rules": "node scripts/build-rules.mjs",
    "rules:deploy": "node scripts/build-rules.mjs && firebase deploy --only database,storage --project rally-trip",
    "backup": "node scripts/backup-storage.mjs"
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-quill-new": "^3.8.3",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "firebase-tools": "^15.36.0",
    "jsdom": "^31.0.1",
    "vitest": "^5.1.0"
  }
}
